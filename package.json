{
  "name": "guzhenren",
  "version": "0.1.0",
  "description": "蛊真人主题 DSH Web 动态皮肤：逆流河、白凝冰、黑楼兰与方源四景。",
  "type": "module",
  "license": "MIT",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "ASSETS.md",
    "LICENSE",
    "screenshots.json",
    "screenshots"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm test",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "author": "fanchw",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fanchw/guzhenren.git"
  },
  "homepage": "https://github.com/fanchw/guzhenren#readme"
}
